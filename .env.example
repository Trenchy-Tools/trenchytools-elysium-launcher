# The TrenchyTools API. Get a key with one call (no account):  curl "https://api.trenchy.tools/api/create-api-key?label=elysium-launcher"
TRENCHY_API_URL=https://api.trenchy.tools
TRENCHY_API_KEY=

# Where your wallet files live. Leave empty for ./wallets inside this repo (git-ignored). Set the same folder in every starter to share wallets.
# The folder is shared with the other starters; this app only reads files with "chain": "elysium".
WALLET_BACKUP_DIR=

PORT=3000
